# Copy to .env and fill in. Never commit .env — it is gitignored.

# --- Core services ---
DATABASE_URL=postgresql+psycopg://scraplink:scraplink@localhost:5432/scraplink
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- ML inference service ---
ML_SERVICE_URL=http://localhost:8001
ML_CLASSIFICATION_CONFIDENCE_THRESHOLD=0.75

# --- Payments (Razorpay Route — sandbox keys only for the pilot) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Object storage (lot imagery, certificates) ---
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=INFO
