# Copy to .env and fill in. Never commit .env — it is gitignored.

# --- Core services ---
# PostgreSQL is the target (install the backend with the [postgres] extra). For local work
# without Postgres: DATABASE_URL=sqlite:///./scraplink-dev.db
DATABASE_URL=postgresql+psycopg://scraplink:scraplink@localhost:5432/scraplink
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- ML inference service ---
# Leave empty to run without it: sellers then pick category and grade by hand.
# 127.0.0.1, not localhost: on Windows localhost tries IPv6 first and adds ~2 s per call.
ML_SERVICE_URL=http://127.0.0.1:8001
ML_CLASSIFICATION_CONFIDENCE_THRESHOLD=0.75

# --- Payments (Razorpay Route — sandbox keys only for the pilot) ---
# "simulated" funds escrow without moving money (development and demos only).
PAYMENT_GATEWAY=simulated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Trade rules ---
# Escrow covers declared weight x (1 + tolerance); price range shown is estimate +/- band.
ESCROW_WEIGHT_TOLERANCE=0.10
PRICE_BAND=0.10
# Hours a winning buyer has to pay into escrow before the lot passes to the next bidder.
ESCROW_FUNDING_HOURS=24

# --- Web ---
# Where people open the web client; certificate "verify" links point here.
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]

# --- Object storage (lot imagery, certificates) ---
# Until the S3 adapter lands, files are written under MEDIA_DIR.
MEDIA_DIR=./media
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=INFO
