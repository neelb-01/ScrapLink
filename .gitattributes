# Normalise line endings across Windows/macOS/Linux checkouts.
* text=auto eol=lf

*.md        text
*.py        text
*.ts        text
*.tsx       text
*.js        text
*.jsx       text
*.json      text
*.yml       text
*.yaml      text
*.toml      text
*.sql       text
*.sh        text eol=lf
*.ps1       text eol=crlf

# Binary assets — never diff or line-ending-convert these.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.pdf       binary
*.pt        binary
*.onnx      binary
*.tflite    binary

# Documentation should not skew the repository's reported language.
*.md        linguist-documentation
